{
  "name": "@signalridge/jaist-vpn-auth",
  "version": "0.1.0",
  "description": "Obtain JAIST F5 VPN sessions through JAIST SSO",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "jaist-vpn-auth": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check --error-on-warnings . && tsc --noEmit && bun test",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && bun install --lockfile-only && bun run format",
    "publish-packages": "bun scripts/publish-changesets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "2.31.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalridge/jaist-vpn-auth.git"
  },
  "homepage": "https://github.com/signalridge/jaist-vpn-auth#readme",
  "bugs": {
    "url": "https://github.com/signalridge/jaist-vpn-auth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "jaist",
    "saml",
    "sso",
    "bun",
    "vpn",
    "f5"
  ],
  "dependencies": {
    "@signalridge/jaist-sso": "0.1.0"
  }
}
